# Copy to .env and fill in. Everything has a working offline default.

# --- Nemotron (build.nvidia.com, OpenAI-compatible) ---
# mock = offline rule-based planner (no key needed); nvidia = real Nemotron
LLM_MODE=mock
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Checked against a real key on Nov 8 (nemotron-3-super-120b and nano-3-30b returned 404 for our account).
# REASONING_MODEL is used when AGENT_MODE=single.
REASONING_MODEL=nvidia/nemotron-3-ultra-550b-a55b
VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# off = ~1-3 s per camera frame; on = ~5-15 s (model reasons before answering)
VISION_THINKING=off
# native = OpenAI "tools" parameter; json = ask for strict JSON and parse it ourselves (fallback)
TOOL_CALL_MODE=native
MAX_STEPS=16

# --- Agent team ---
# team = coordinator delegates to triage + search agents; single = one agent with every tool
AGENT_MODE=team
# workflow = code runs the detection path, Nemotron reads frames and decides triage (fast, default)
# agent = the coordinator decides every step (slower; the original fully agentic flow)
DETECTION_MODE=workflow
# Per-role models: biggest model plans, fast models do the hands-on loops.
COORDINATOR_MODEL=nvidia/nemotron-3-ultra-550b-a55b
TRIAGE_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
SEARCH_MODEL=nvidia/nemotron-3.5-bolt-e4b
SUB_MAX_STEPS=16

# --- Robot ---
# sim = simulated PiCrawler in a room
# prada = the real robot: camera GET /frame + speech service (speak/listen); the agent cannot drive it
# pi = legacy WebSocket command adapter (the Pi does not implement it)
ROBOT_MODE=sim
CAMERA_URL=http://prada.local:8080
# Optional override. Blank uses the build Mac's Bonjour hostname on port 8788 in the visor.
AGENT_URL=
# prada only: how long to wait for the rescuer to turn the robot before a second look
SECOND_LOOK_WAIT_MS=2500
ROBOT_ID=1
PI_WS_URL=ws://raspberrypi.local:8765
# Robot loudspeaker (text-to-speech on the Pi, robot/picrawler_control/speech.py): off | pi
SPEAKER_MODE=off
SPEAKER_URL=http://prada.local:8081
# Same secret as ROBOT_CONTROL_TOKEN in /etc/picrawler-control.env on prada
ROBOT_CONTROL_TOKEN=

# --- Operator voice (spoken updates for the rescuer) ---
# on = headset alerts are rewritten for the ear and served at http://<host>:<port>/operator (earpiece page)
OPERATOR_VOICE=on
# 0.0.0.0 to let a phone on the LAN open the earpiece page
OPERATOR_FEED_HOST=0.0.0.0
OPERATOR_FEED_PORT=8788

# --- Shared state ---
# memory = in-process store; spacetime = SpacetimeDB over HTTP (see docs/spacetime.md)
STATE_MODE=memory
SPACETIME_URL=https://maincloud.spacetimedb.com
SPACETIME_DB=rescue-robot
SPACETIME_TOKEN=
# Search area in meters: minX,minY,maxX,maxY
SEARCH_AREA=0,0,8,6

# --- Operator confirmations (dispatch) ---
# In memory mode: approve | deny | none (none = wait for timeout)
AUTO_CONFIRM=approve
CONFIRM_TIMEOUT_MS=30000

# --- Responder notifications ---
# console = print only; twilio = real SMS
NOTIFY_MODE=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Comma-separated E.164 numbers
RESPONDER_PHONES=

# --- Timers (ms) ---
SITREP_INTERVAL_MS=120000
STALE_CASE_MS=300000
WATCH_INTERVAL_MS=1000
LOG_DIR=logs

# Prada mission dashboard (required for admitting Visor detections in prada mode)
DASHBOARD_URL=http://127.0.0.1:8090
# Dashboard reads this to display operator alerts
DASHBOARD_AGENT_URL=http://127.0.0.1:8788

# Private agent-to-dashboard secret; not required or sent by the Visor LAN intake.
AGENT_TOKEN=

# Property damage evidence storage (default: data/incidents relative to agent working directory).
# DAMAGE_DATA_DIR=/absolute/path/to/private/incident-data
