{
  "name": "rescue-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Nemotron agent that runs the rescue robot's mission: search planning, second-look triage, survivor talk, takeover requests, responder alerts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "demo": "tsx src/demo.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "web": "tsx src/web/server.ts",
    "eval:scenes": "tsx src/scenes/eval.ts",
    "latency": "tsx src/scenes/latency.ts",
    "prada:check": "tsx src/prada-check.ts",
    "migrate:spacetime": "tsx src/shared/migrate.ts",
    "demo:export": "tsx src/shared/demo-snapshot.ts export ../demo-data",
    "demo:restore": "tsx src/shared/demo-snapshot.ts restore ../demo-data"
  },
  "dependencies": {
    "jpeg-js": "^0.4.4",
    "openai": "^7.53.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
